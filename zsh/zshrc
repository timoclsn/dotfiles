# Kept minimal on purpose: terminals start fish, and zsh is only what agents and
# scripts run (`zsh -ic`). It needs the environment, PATH and the aliases and
# functions those callers use. Anything for typing at a prompt lives in fish.

# Keep PATH entries unique automatically
typeset -U path PATH

# =============================================================================
# Environment Variables
# =============================================================================
export XDG_CONFIG_HOME="$HOME/.config"
export EDITOR='nvim'
export GOPRIVATE=github.com/steuerbot/*,github.com/taxfix/*
export FZF_DEFAULT_OPTS_FILE="$HOME/.config/fzf/fzfrc"

# Load env vars from .env file
[ -f "$HOME/.env" ] && source "$HOME/.env"

# =============================================================================
# PATH
# =============================================================================
export ANDROID_SDK_ROOT=$HOME/Library/Android/sdk
export PNPM_HOME="$HOME/Library/pnpm"
export BUN_INSTALL="$HOME/.bun"
export PYENV_ROOT="$HOME/.pyenv"

path+=(
  $ANDROID_SDK_ROOT/emulator
  $ANDROID_SDK_ROOT/platform-tools
  $HOME/.lmstudio/bin
)
# Shims instead of `rbenv init`/`pyenv init` (~130ms per start)
path=(
  $HOME/.local/bin
  $HOME/.opencode/bin
  $HOME/.rbenv/shims
  $PYENV_ROOT/shims
  $PYENV_ROOT/bin
  $HOME/.turso
  $BUN_INSTALL/bin
  $HOME/.npm-global/bin
  $PNPM_HOME/bin
  /opt/homebrew/opt/ruby/bin
  $path
)

eval "$(fnm env)"

# =============================================================================
# Aliases and functions used by agents and scripts
# =============================================================================
# Personal projects use the personal Claude login, everything else the work one.
# Pass --work or --personal (also through the cc* aliases) to pick the login
# regardless of the project.
claude() {
  local arg account_flag
  local -a args
  for arg in "$@"; do
    case $arg in
      --work | --personal) account_flag=$arg ;;
      *) args+=("$arg") ;;
    esac
  done

  local config_dir
  if [[ -n $account_flag ]]; then
    config_dir=$(claude-config-dir "$account_flag")
  else
    config_dir=${CLAUDE_CONFIG_DIR:-$(claude-config-dir "$PWD")}
  fi

  # The work login is the default one, which needs CLAUDE_CONFIG_DIR unset
  if [[ -n $config_dir ]]; then
    CLAUDE_CONFIG_DIR=$config_dir command claude "${args[@]}"
  else
    env -u CLAUDE_CONFIG_DIR claude "${args[@]}"
  fi
}
alias cc="claude --model claude-opus-5-5 --effort medium"
alias ccw="cc --worktree"
alias ccs="cc --model claude-sonnet-5-5 --effort medium"
alias ccsw="ccs --worktree"
alias cch="cc --model claude-haiku-5-5 --effort medium"
alias cchw="cch --worktree"
alias cx="codex --dangerously-bypass-approvals-and-sandbox"
alias ca="cursor-agent"

# comview
alias cv="git diff | comview"
cvpr() {
  local base
  base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) \
    || base="origin/$(git config --get init.defaultBranch 2>/dev/null || echo main)"
  git diff "$(git merge-base HEAD "$base")"...HEAD | comview
}
cvgh() { gh pr diff "$@" | comview; }
