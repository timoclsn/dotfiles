#!/usr/bin/env bash

dirs=(
    ~/Developer/personal
    ~/Developer/steuerbot
    ~/Developer/taxfix
    ~/Developer/codeatelier
    ~/Library/Mobile\ Documents/iCloud~md~obsidian/Documents
)

# --detach sets the session up without attaching or switching the client to it,
# so a script (or an agent) can prepare a session without stealing the user's view.
# A session it creates is also left on the 'agents' window instead of 'code'.
# --prompt starts the agent in a newly created session with that text as its
# first message, so a script (or an agent) can hand over a task right away.
detach=""
prompt=""
selected=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -d | --detach)
            detach=1
            shift
            ;;
        -p | --prompt)
            prompt=$2
            shift 2
            ;;
        *)
            selected=$1
            shift
            ;;
    esac
done

if [[ -z $selected ]]; then
    result=$(find "${dirs[@]}" -mindepth 1 -maxdepth 1 -type d | fzf --border-label " Select Project " --expect=ctrl-y)
    { read -r key; read -r selected; } <<< "$result"
fi

if [[ -z $selected ]]; then
    exit 0
fi

if [[ $key == "ctrl-y" ]]; then
    printf '%s' "$selected" | sed "s|^$HOME|~|" | pbcopy
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $detach ]] && [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    exit 0
fi

if ! tmux has-session -t="$selected_name" 2> /dev/null; then
    # Start a new session with the first window named 'code' and open neovim
    tmux new-session -ds "$selected_name" -c "$selected" -n code
    tmux send-keys -t "$selected_name:code" "nvim" Enter

    # Create a second window named 'source' and open lazygit
    tmux new-window -t "$selected_name:" -n source -c "$selected"
    tmux send-keys -t "$selected_name:source" "lazygit" Enter

    # Create a third window named 'agents' with a vertical split
    tmux new-window -t "$selected_name:" -n agents -c "$selected"
    tmux split-window -t "$selected_name:agents" -h -c "$selected"
    # Run 'cc' in the left pane, leave the right pane as a plain terminal.
    # The prompt goes through a temp file the pane's shell reads (and deletes),
    # so quotes, newlines and '!' reach cc without any shell quoting.
    agent_command="cc"
    if [[ -n $prompt ]]; then
        prompt_file=$(mktemp -t tmux-sessionizer-prompt)
        printf '%s' "$prompt" > "$prompt_file"
        agent_command="cc \"\$(cat $prompt_file && rm $prompt_file)\""
    fi
    sleep 0.2
    tmux send-keys -t "$selected_name:agents.1" -l "$agent_command"
    tmux send-keys -t "$selected_name:agents.1" Enter
    # Focus the left pane
    tmux select-pane -t "$selected_name:agents.left"
    
    # Create a fourth window named 'cmd'
    tmux new-window -t "$selected_name:" -n cmd -c "$selected"

    # A session remembers its current window even while nobody is attached, so a
    # detached setup lands the user on the agent right where the work happens.
    if [[ -n $detach ]]; then
        tmux select-window -t "$selected_name:agents"
    else
        tmux select-window -t "$selected_name:code"
    fi
fi

if [[ -n $detach ]]; then
    printf '%s\n' "$selected_name"
    exit 0
fi

if [[ -z $TMUX ]]; then
    tmux attach-session -t "$selected_name"
else
    tmux switch-client -t "$selected_name"
fi
