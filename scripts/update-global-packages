#!/bin/bash
set -e

echo "Updating Claude Code…"
claude update

echo ""
echo "Updating OpenCode…"
opencode upgrade

echo ""
echo "Updating pnpm…"
pnpm self-update -y

echo ""
echo "Updating Bun…"
bun upgrade

echo ""
echo "Updating GitHub CLI extensions…"
gh extension upgrade --all

echo ""

PACKAGES=(
  "npm"
  "@antfu/ni"
  "npm-check-updates"
  "vercel"
  "yalc"
  "@openai/codex"
  "@google/gemini-cli"
  "@github/copilot"
  "@earendil-works/pi-coding-agent"
  "playwriter"
  "@googleworkspace/cli"
  "hunkdiff"
  "@taxfix/altitudo-cli"
)

echo "Updating global npm packages (${#PACKAGES[@]} total)…"

npm i -g "${PACKAGES[@]}"

echo ""
echo "Installed global packages:"
echo ""

npm list -g --depth=0

echo ""
echo "Updating Homebrew packages…"
brew upgrade --no-ask

echo ""
echo "All updates complete!"
