#!/usr/bin/env bash

# Rex counterpart of tmux-sessionizer. The session setup and the project
# picker live in the `sessionizer` action in rex/init.lua; this script passes
# the arguments on to it.

# --detach sets the session up without switching the app to it and prints the
# session name. It needs a project directory, as there is no one to ask.
# --prompt starts the agent in a newly created session with that text as its
# first message.
# --right runs a shell command in a second pane next to the agent.
detach=""
prompt=""
right=""
selected=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -d | --detach)
            detach=1
            shift
            ;;
        -p | --prompt)
            prompt=$2
            shift 2 || { echo "$1 needs a value" >&2; exit 1; }
            ;;
        -r | --right)
            right=$2
            shift 2 || { echo "$1 needs a value" >&2; exit 1; }
            ;;
        *)
            selected=$1
            shift
            ;;
    esac
done

args=()
if [[ -n $selected ]]; then
    # Rex resolves paths from its own working directory, not this shell's.
    selected=$(cd "$selected" && pwd) || exit 1
    args+=("dir=$selected")
elif [[ -n $detach ]]; then
    echo "--detach needs a project directory" >&2
    exit 1
fi
[[ -n $prompt ]] && args+=("prompt=$prompt")
[[ -n $right ]] && args+=("right=$right")

if [[ -n $detach ]]; then
    # Fail when rex fails, not only when jq does, so callers notice.
    set -o pipefail
    rex do sessionizer "${args[@]}" detach=true --json | jq -r .session
else
    rex do sessionizer "${args[@]}" > /dev/null
fi
