#!/bin/bash
set -e

echo "Updating Claude Code…"
claude update

echo ""
echo "Updating OpenCode…"
opencode upgrade

echo ""
echo "Updating pnpm…"
pnpm self-update -y

echo ""
echo "Updating Bun…"
bun upgrade

echo ""
echo "Updating GitHub CLI extensions…"
gh extension upgrade --all

echo ""

PACKAGES=(
  "npm"
  "@antfu/ni"
  "npm-check-updates"
  "vercel"
  "yalc"
  "@openai/codex"
  "@google/gemini-cli"
  "@github/copilot"
  "@earendil-works/pi-coding-agent"
  "@googleworkspace/cli"
  "hunkdiff"
  "@taxfix/altitudo-cli"
  "ccusage"
)

echo "Updating global npm packages (${#PACKAGES[@]} total)…"

npm i -g "${PACKAGES[@]}"

echo ""
echo "Installed global packages:"
echo ""

npm list -g --depth=0

echo ""
echo "Updating Neovim Mason tools…"
nvim --headless "+MasonToolsUpdateSync" +qa

echo ""
echo "Updating Neovim Treesitter parsers…"
nvim --headless "+lua require('nvim-treesitter').update():wait(300000)" +qa

echo ""
echo "Updating Claude Code plugins…"
claude plugin marketplace update
claude plugin list --json | jq -r '.[] | select(.id | endswith("@synced") | not) | .id' | xargs -n1 claude plugin update

echo ""
echo "Updating Homebrew packages…"
brew upgrade --no-ask
brew cleanup

echo ""
echo "All updates complete!"
