#!/bin/bash
set -o pipefail

BREWFILE="$(dirname "$(realpath "$0")")/../homebrew/Brewfile"

PACKAGES=(
  "npm"
  "@antfu/ni"
  "npm-check-updates"
  "vercel"
  "yalc"
  "@openai/codex"
  "@google/gemini-cli"
  "@github/copilot"
  "@earendil-works/pi-coding-agent"
  "@googleworkspace/cli"
  "@taxfix/altitudo-cli"
  "ccusage"
)

update_claude() {
  echo "Updating Claude Code…"
  claude update
  echo "Updating Claude Code plugins…"
  claude plugin marketplace update
  claude plugin list --json | jq -r '.[] | select(.id | endswith("@synced") | not) | .id' | xargs -n1 claude plugin update
}

update_opencode() {
  echo "Updating OpenCode…"
  opencode upgrade
}

update_pnpm() {
  echo "Updating pnpm…"
  pnpm self-update -y
}

update_bun() {
  echo "Updating Bun…"
  bun upgrade
}

update_npm_packages() {
  echo "Updating global npm packages (${#PACKAGES[@]} total)…"
  npm i -g "${PACKAGES[@]}"
  echo ""
  echo "Installed global packages:"
  npm list -g --depth=0
}

update_homebrew() {
  local status=0
  echo "Updating GitHub CLI extensions…"
  gh extension upgrade --all || status=1
  echo "Updating Homebrew packages…"
  brew upgrade --no-ask || status=1
  brew cleanup || status=1
  return $status
}

# Only reports: packages that are listed but missing, then ones that are
# installed but not listed. Whether to add or uninstall them is up to the user.
# Cleanup is limited to taps, formulae and casks because its go and uv checks
# fail on mise shims that have no global version.
report_brewfile_drift() {
  echo "Checking Homebrew against the Brewfile…"
  brew bundle check --verbose --no-upgrade --file="$BREWFILE"
  brew bundle cleanup --tap --formula --cask --file="$BREWFILE"
}

# Headless nvim exits 0 even when a command errors, so turn errors into an exit code.
run_in_nvim() {
  nvim --headless "+lua local ok, err = pcall(function() $1 end) if not ok then print(err) vim.cmd.cquit() end" +qa
}

# Runs after Homebrew and the npm update finish: Homebrew replaces nvim, and
# Mason installs many of its tools with npm.
update_neovim() {
  local status=0
  echo "Updating Neovim Mason tools…"
  run_in_nvim "vim.cmd.MasonToolsUpdateSync()" || status=1
  echo "Updating Neovim Treesitter parsers…"
  run_in_nvim "assert(require('nvim-treesitter').update():wait(300000))" || status=1
  return $status
}

logs=$(mktemp -d)
trap 'rm -rf "$logs"' EXIT
background_groups=(claude opencode pnpm bun npm_packages)
pids=()

# These groups run in the background with their output buffered in a log file,
# so parallel output doesn't interleave. The logs are printed once they finish.
for group in "${background_groups[@]}"; do
  (
    started=$SECONDS
    (set -e; "update_$group") >"$logs/$group.log" 2>&1
    status=$?
    if [ "$status" -eq 0 ]; then mark="✔"; else mark="✘"; fi
    echo "$mark $group ($((SECONDS - started))s)"
    exit "$status"
  ) &
  pids+=($!)
done

# Homebrew runs in the foreground because it often asks for the sudo password,
# which a background job can't be prompted for.
failed=()
echo "Running ${#background_groups[@]} update groups in the background…"
echo ""
update_homebrew || failed+=(homebrew)
echo ""
report_brewfile_drift

for i in "${!background_groups[@]}"; do
  group=${background_groups[$i]}
  echo ""
  echo "━━ $group ━━"
  wait "${pids[$i]}" || failed+=("$group")
  cat "$logs/$group.log"
done

echo ""
update_neovim || failed+=(neovim)

echo ""
if [ ${#failed[@]} -eq 0 ]; then
  echo "All updates complete!"
  exit 0
fi
echo "Failed: ${failed[*]}"
exit 1
