brew "fx"
brew "watchman"

# Media and documents
brew "yt-dlp"
brew "ffmpeg"

# Git
brew "gh"
brew "lazygit"
brew "git-delta"
brew "hunk"
brew "atlassian/acli/acli", trusted: true

# Containers and infrastructure
