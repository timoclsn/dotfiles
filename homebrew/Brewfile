brew "fnm"
brew "rbenv"
brew "pyenv"
brew "ruby"
brew "uv"
brew "zig"

# Editor and file tools
brew "neovim"
brew "tree-sitter-cli"
brew "ripgrep"
brew "fd"
brew "bat"
