# Only what I installed on purpose; Homebrew pulls in the dependencies itself.
# Edit by hand, then run `brew bundle`. `update-tools` reports packages that are
# installed but missing here (or the other way around).

# Taps (only for packages that are not in Homebrew core). Homebrew refuses to
# load third-party taps unless they are trusted, and `brew bundle cleanup`
# resets the trust store to what is declared here. So trust is declared per
# package with `trusted:`, including dependencies that come from the same tap.
tap "atlassian/acli"
tap "mongodb/brew", trusted: { formula: "mongodb-database-tools" }
tap "tursodatabase/tap"
tap "libsql/sqld", trusted: { formula: "sqld" }

# Shell and terminal
brew "bash"
brew "fish"
brew "starship"
